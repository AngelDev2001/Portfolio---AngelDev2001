---
import CodeXml from "lucide-astro/CodeXml";
import ContentWidth from "../components/ContentWidth.astro";

const EXPERIENCIAS = [
  {
    puesto: "Desarrollador Full-Stack / Líder Técnico",
    empresa: "Servitec Peru Group E.I.R.L.",
    ubicacion: "Lima, Perú",
    fecha: "Oct. 2023 – Presente",
    logo: "/companies/logo-servitec.png",
    descripcion:
      "Liderazgo técnico y desarrollo full-stack de sistemas empresariales críticos, optimizando flujos de trabajo internos y plataformas orientadas a miles de usuarios.",
    logros: [
      "Digitalización del sistema Korekenke (JBIENE - Ejército del Perú), integrando solicitudes de convenios, descuentos y notificaciones omnicanal (Email/WhatsApp).",
      "Construcción de la arquitectura interna para gestión de accesos, roles, permisos, asistencias y vacaciones del personal.",
      "Desarrollo del hub centralizado platform.servitecperu.com para consolidar formularios, cotizaciones, proveedores y reclamos en tiempo real.",
      "Refactorización y modernización del código base de sitios web corporativos para reducir tiempos de carga y mejorar el UI/UX.",
    ],
  },
];
---

<section
  id="experiencia"
  class="py-16 md:py-24 border-t border-neutral-200 dark:border-neutral-900"
>
  <ContentWidth>
    <div class="max-w-3xl space-y-10">
      <h2 class="text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-white tracking-tight">
        Experiencia Laboral
      </h2>

      <div class="space-y-12">
        {EXPERIENCIAS.map((exp) => (
          <article class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-4 md:gap-6 items-start">
            <div class="w-12 h-12 rounded-xl bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 flex items-center justify-center p-2 shrink-0">
              <img
                src={exp.logo}
                alt={`Logo de ${exp.empresa}`}
                class="w-full h-full object-contain"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
              />
              <span class="hidden text-xs font-bold text-neutral-500">
                {exp.empresa.substring(0, 2).toUpperCase()}
              </span>
            </div>

            <div class="space-y-3">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <div>
                  <h3 class="text-lg sm:text-xl font-bold text-neutral-900 dark:text-white leading-snug">
                    {exp.puesto}
                  </h3>
                  <p class="text-sm font-medium text-brand-red">
                    {exp.empresa}{" "}
                    <span class="text-neutral-400 dark:text-neutral-600">
                      •
                    </span>{" "}
                    <span class="text-neutral-600 dark:text-neutral-400">
                      {exp.ubicacion}
                    </span>
                  </p>
                </div>
                <time class="text-xs font-semibold text-neutral-500 dark:text-neutral-400 sm:text-right shrink-0">
                  {exp.fecha}
                </time>
              </div>

              <p class="text-neutral-700 dark:text-neutral-300 text-sm sm:text-base leading-relaxed">
                {exp.descripcion}
              </p>

              <ul class="space-y-2 pt-1 text-sm text-neutral-600 dark:text-neutral-400 list-none">
                {exp.logros.map((logro) => (
                  <li class="flex items-start gap-2">
                    <CodeXml class="w-5 h-5 shrink-0 mt-0.5 text-neutral-400 dark:text-neutral-600" />
                    <span class="text-neutral-700 dark:text-neutral-300">
                      {logro}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </ContentWidth>
</section>
