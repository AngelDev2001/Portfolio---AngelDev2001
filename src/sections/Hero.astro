---
import ContentWidth from "../components/ContentWidth.astro";
---

<section id="inicio" class="pt-28 pb-16 md:pt-36 md:pb-24">
  <ContentWidth>
    <div class="max-w-2xl space-y-6">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-neutral-900 dark:text-white leading-none">
        Hola, soy <span class="text-brand-red">Angel Gala</span>
      </h1>

      <p class="text-lg sm:text-xl text-neutral-700 dark:text-neutral-300 leading-relaxed font-normal">
        <strong class="text-neutral-900 dark:text-white font-semibold">
          +3 años de experiencia.
        </strong>{" "}
        Técnico en Computación e Informática y Desarrollador Web de{" "}
        <strong class="text-neutral-900 dark:text-white font-semibold">
          Lima, Perú
        </strong>
        . Enfocado en construir interfaces web rápidas, intuitivas y diseñadas
        para ser accesibles y fáciles de usar por cualquier persona.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="mailto:egala.flores@gmail.com"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-brand-red hover:bg-brand-red-hover text-white font-medium text-sm transition-all duration-200 shadow-lg shadow-brand-red/20 active:scale-95 cursor-pointer"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          Contáctame
        </a>

        <a
          href="/cv-angel-emilio-gala-flores.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-900 dark:hover:bg-neutral-800 text-neutral-800 dark:text-neutral-200 border border-neutral-300 dark:border-neutral-800 font-medium text-sm transition-all duration-200 active:scale-95 cursor-pointer"
        >
          <svg
            class="w-4 h-4 text-neutral-500 dark:text-neutral-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
          Descargar CV
        </a>

        <a
          href="https://www.linkedin.com/in/angel-emilio-gala-flores"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Perfil de LinkedIn"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-900 dark:hover:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border border-neutral-300 dark:border-neutral-800 text-sm font-medium transition-all duration-200 hover:text-neutral-900 dark:hover:text-white hover:border-neutral-400 dark:hover:border-neutral-700 active:scale-95 cursor-pointer"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.6a1.49 1.49 0 0 0-1.5 1.5 1.5 1.5 0 0 0 1.5 1.5 1.5 1.5 0 0 0 1.5-1.5 1.49 1.49 0 0 0-1.5-1.5z"></path>
          </svg>
          <span>LinkedIn</span>
        </a>

        <a
          href="https://github.com/AngelDev2001"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Perfil de GitHub"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-neutral-100 hover:bg-neutral-200 dark:bg-neutral-900 dark:hover:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border border-neutral-300 dark:border-neutral-800 text-sm font-medium transition-all duration-200 hover:text-neutral-900 dark:hover:text-white hover:border-neutral-400 dark:hover:border-neutral-700 active:scale-95 cursor-pointer"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"></path>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>
  </ContentWidth>
</section>
