---
interface Props {
  type?: "playlist" | "album" | "track";
  id?: string;
  label?: string;
}

const {
  type = "playlist",
  id = "0p7ZR2OkuRCFNApTxAwT6U",
  label = "Mi lista en Spotify",
} = Astro.props;

const embedUrl = `https://open.spotify.com/embed/${type}/${id}?utm_source=generator&theme=0`;
---

<div id="spotify-container" class="fixed bottom-6 left-6 z-50 group">
  <div
    id="spotify-popover"
    class="hidden absolute bottom-16 left-0 w-[300px] sm:w-[350px] p-3.5 rounded-2xl bg-white/95 dark:bg-neutral-950/95 border border-neutral-200 dark:border-neutral-800 shadow-2xl backdrop-blur-md transition-all duration-300 origin-bottom-left scale-90 opacity-0 -translate-y-2 pointer-events-none"
  >
    <div class="flex items-center justify-between mb-2.5 px-1">
      <div class="flex items-center gap-2">
        <svg
          class="w-4 h-4 text-emerald-500"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141 C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C13.5 8.4 7.5 8.16 4.02 9.24c-.6.18-1.26-.18-1.44-.72-.18-.6.18-1.26.72-1.44C7.38 5.88 13.98 6.12 18.3 8.7c.54.3.72 1.02.42 1.56-.3.42-1.02.6-1.56.3z" />
        </svg>
        <span class="text-xs font-semibold text-neutral-800 dark:text-neutral-200">
          {label}
        </span>
      </div>

      <button
        id="spotify-close"
        aria-label="Cerrar reproductor"
        class="p-1 text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800/60 transition-colors cursor-pointer"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>
    </div>

    <div class="overflow-hidden rounded-xl bg-neutral-100 dark:bg-neutral-900/60">
      <iframe
        src={embedUrl}
        width="100%"
        height="152"
        frameborder="0"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
        class="w-full border-0 block"
      ></iframe>
    </div>
  </div>

  <button
    id="spotify-toggle"
    aria-label="Ver playlist de Spotify"
    class="relative inline-flex items-center justify-center p-[1.5px] overflow-hidden rounded-full shadow-2xl shadow-emerald-500/20 active:scale-95 transition-transform duration-200 cursor-pointer"
  >
    <span class="absolute inset-[-1000%] animate-spin-border bg-[conic-gradient(from_90deg_at_50%_50%,#e5e5e5_0%,#1DB954_50%,#3be477_75%,#e5e5e5_100%)] dark:bg-[conic-gradient(from_90deg_at_50%_50%,#000000_0%,#1DB954_50%,#3be477_75%,#000000_100%)]"></span>

    <span class="relative z-10 flex items-center gap-2.5 px-3.5 py-2.5 rounded-full bg-white/90 hover:bg-white dark:bg-neutral-950/90 dark:hover:bg-neutral-900/90 text-neutral-800 dark:text-neutral-200 hover:text-neutral-950 dark:hover:text-white backdrop-blur-md transition-colors duration-300">
      <span class="relative flex items-center justify-center text-emerald-500 dark:text-emerald-400 group-hover:scale-110 transition-transform duration-300">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141 C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C13.5 8.4 7.5 8.16 4.02 9.24c-.6.18-1.26-.18-1.44-.72-.18-.6.18-1.26.72-1.44C7.38 5.88 13.98 6.12 18.3 8.7c.54.3.72 1.02.42 1.56-.3.42-1.02.6-1.56.3z" />
        </svg>
      </span>
      <span class="hidden md:inline text-xs font-semibold tracking-wide">
        Música
      </span>
    </span>
  </button>
</div>

<script>
  const toggleBtn = document.getElementById("spotify-toggle");
  const closeBtn = document.getElementById("spotify-close");
  const popover = document.getElementById("spotify-popover");
  const container = document.getElementById("spotify-container");

  function openPopover() {
    if (!popover) return;
    popover.classList.remove("hidden");
    setTimeout(() => {
      popover.classList.remove(
        "scale-90",
        "opacity-0",
        "-translate-y-2",
        "pointer-events-none"
      );
      popover.classList.add("scale-100", "opacity-100", "translate-y-0");
    }, 10);
  }

  function closePopover() {
    if (!popover) return;
    popover.classList.remove("scale-100", "opacity-100", "translate-y-0");
    popover.classList.add(
      "scale-90",
      "opacity-0",
      "-translate-y-2",
      "pointer-events-none"
    );
    setTimeout(() => {
      popover.classList.add("hidden");
    }, 300);
  }

  toggleBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isHidden = popover?.classList.contains("hidden");
    if (isHidden) {
      openPopover();
    } else {
      closePopover();
    }
  });

  closeBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    closePopover();
  });

  document.addEventListener("click", (e) => {
    if (container && !container.contains(e.target as Node)) {
      closePopover();
    }
  });
</script>
