---
import ContentWidth from "../components/ContentWidth.astro";
---

<header class="fixed top-0 left-0 right-0 z-50 py-4 transition-all duration-300">
  <ContentWidth>
    <div
      id="nav-container"
      class="flex items-center justify-between px-5 py-2.5 rounded-full transition-all duration-300 border border-transparent bg-transparent"
    >
      <a
        href="#inicio"
        aria-label="Ir al inicio"
        class="flex items-center hover:opacity-80 transition-opacity"
      >
        <img
          id="logo-dark"
          src="/logo.png"
          alt="Logo de Angel Gala"
          class="h-8 w-auto object-contain hidden dark:block"
        />
        <img
          id="logo-light"
          src="/logo-light.png"
          alt="Logo de Angel Gala"
          class="h-8 w-auto object-contain block dark:hidden"
        />
      </a>

      <div class="hidden md:flex items-center gap-6 lg:gap-8">
        <nav class="flex items-center gap-6 lg:gap-8">
          <a
            href="#experiencia"
            class="text-neutral-700 dark:text-neutral-300 hover:text-brand-red transition-colors duration-200 text-sm font-medium"
          >
            Experiencia
          </a>
          <a
            href="#proyectos"
            class="text-neutral-700 dark:text-neutral-300 hover:text-brand-red transition-colors duration-200 text-sm font-medium"
          >
            Proyectos
          </a>
          <a
            href="#sobre-mi"
            class="text-neutral-700 dark:text-neutral-300 hover:text-brand-red transition-colors duration-200 text-sm font-medium"
          >
            Sobre Mí
          </a>
          <a
            href="mailto:egala.flores@gmail.com"
            class="text-neutral-700 dark:text-neutral-300 hover:text-brand-red transition-colors duration-200 text-sm font-medium"
          >
            Contacto
          </a>
        </nav>

        <div class="h-4 w-[1px] bg-neutral-300 dark:bg-neutral-800"></div>

        <div class="relative">
          <button
            id="theme-toggle-btn"
            class="text-neutral-700 dark:text-neutral-300 hover:text-brand-red p-1 transition-colors flex items-center justify-center focus:outline-none cursor-pointer"
            aria-label="Seleccionar tema"
          >
            <svg
              id="theme-icon-system"
              class="w-5 h-5 hidden"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <rect
                x="2"
                y="3"
                width="20"
                height="14"
                rx="2"
                stroke-width="2"
              ></rect>
              <path
                stroke-linecap="round"
                stroke-width="2"
                d="M8 21h8M12 17v4"
              ></path>
            </svg>
            <svg
              id="theme-icon-light"
              class="w-5 h-5 hidden"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <circle cx="12" cy="12" r="5" stroke-width="2"></circle>
              <path
                stroke-linecap="round"
                stroke-width="2"
                d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
              ></path>
            </svg>
            <svg
              id="theme-icon-dark"
              class="w-5 h-5 hidden"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"
              ></path>
            </svg>
          </button>

          <div
            id="theme-dropdown"
            class="hidden absolute right-0 mt-3 w-36 bg-white/95 dark:bg-neutral-900/95 backdrop-blur-md border border-neutral-200 dark:border-neutral-800 rounded-xl p-1 shadow-2xl z-50 text-xs font-medium"
          >
            <button
              data-theme="light"
              class="theme-option w-full text-left px-3 py-2 rounded-lg text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800/60 transition-colors flex items-center justify-between cursor-pointer"
            >
              <span>Claro</span>
              <span class="check-mark hidden text-brand-red font-bold">✓</span>
            </button>
            <button
              data-theme="dark"
              class="theme-option w-full text-left px-3 py-2 rounded-lg text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800/60 transition-colors flex items-center justify-between cursor-pointer"
            >
              <span>Oscuro</span>
              <span class="check-mark hidden text-brand-red font-bold">✓</span>
            </button>
            <button
              data-theme="system"
              class="theme-option w-full text-left px-3 py-2 rounded-lg text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800/60 transition-colors flex items-center justify-between cursor-pointer"
            >
              <span>Sistema</span>
              <span class="check-mark hidden text-brand-red font-bold">✓</span>
            </button>
          </div>
        </div>
      </div>

      <button
        id="mobile-menu-toggle"
        class="md:hidden text-neutral-700 dark:text-neutral-300 hover:text-brand-red p-1.5 transition-colors focus:outline-none cursor-pointer"
        aria-label="Abrir menú de navegación"
      >
        <svg
          id="menu-icon-open"
          class="w-6 h-6 block"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
        <svg
          id="menu-icon-close"
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>
    </div>

    <div
      id="mobile-menu"
      class="hidden md:hidden mt-2 bg-white/95 dark:bg-neutral-900/95 backdrop-blur-md border border-neutral-200 dark:border-neutral-800 rounded-2xl p-4 flex-col gap-3 text-center shadow-xl"
    >
      <a
        href="#experiencia"
        class="mobile-nav-link text-neutral-700 dark:text-neutral-300 hover:text-brand-red py-2 font-medium text-sm transition-colors"
      >
        Experiencia
      </a>
      <a
        href="#proyectos"
        class="mobile-nav-link text-neutral-700 dark:text-neutral-300 hover:text-brand-red py-2 font-medium text-sm transition-colors"
      >
        Proyectos
      </a>
      <a
        href="#sobre-mi"
        class="mobile-nav-link text-neutral-700 dark:text-neutral-300 hover:text-brand-red py-2 font-medium text-sm transition-colors"
      >
        Sobre Mí
      </a>
      <a
        href="mailto:egala.flores@gmail.com"
        class="mobile-nav-link text-neutral-700 dark:text-neutral-300 hover:text-brand-red py-2 font-medium text-sm transition-colors"
      >
        Contacto
      </a>
    </div>
  </ContentWidth>
</header>

<script>
  const navContainer = document.getElementById("nav-container");

  function updateNavOnScroll() {
    if (window.scrollY > 20) {
      navContainer?.classList.remove("bg-transparent", "border-transparent");
      navContainer?.classList.add(
        "bg-white/80",
        "dark:bg-neutral-900/80",
        "backdrop-blur-md",
        "border-neutral-200",
        "dark:border-neutral-800/80",
        "shadow-lg",
        "shadow-black/5",
        "dark:shadow-black/40"
      );
    } else {
      navContainer?.classList.add("bg-transparent", "border-transparent");
      navContainer?.classList.remove(
        "bg-white/80",
        "dark:bg-neutral-900/80",
        "backdrop-blur-md",
        "border-neutral-200",
        "dark:border-neutral-800/80",
        "shadow-lg",
        "shadow-black/5",
        "dark:shadow-black/40"
      );
    }
  }

  window.addEventListener("scroll", updateNavOnScroll);
  updateNavOnScroll();

  const themeBtn = document.getElementById("theme-toggle-btn");
  const themeDropdown = document.getElementById("theme-dropdown");
  const themeOptions = document.querySelectorAll(".theme-option");
  const iconSystem = document.getElementById("theme-icon-system");
  const iconLight = document.getElementById("theme-icon-light");
  const iconDark = document.getElementById("theme-icon-dark");

  function applyTheme(theme: string | null) {
    const root = document.documentElement;
    const systemDark = window.matchMedia(
      "(prefers-color-scheme: dark)"
    ).matches;

    if (theme === "system") {
      root.classList.toggle("dark", systemDark);
    } else {
      root.classList.toggle("dark", theme === "dark");
    }

    iconSystem?.classList.toggle("hidden", theme !== "system");
    iconLight?.classList.toggle("hidden", theme !== "light");
    iconDark?.classList.toggle("hidden", theme !== "dark");

    themeOptions.forEach((opt) => {
      const check = opt.querySelector(".check-mark");
      const optTheme = opt.getAttribute("data-theme");
      if (optTheme === theme) {
        check?.classList.remove("hidden");
      } else {
        check?.classList.add("hidden");
      }
    });

    if (theme != null) {
      localStorage.setItem("theme", theme);
    }
  }

  const savedTheme = localStorage.getItem("theme") || "system";
  applyTheme(savedTheme);

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", (e) => {
      if (localStorage.getItem("theme") === "system") {
        document.documentElement.classList.toggle("dark", e.matches);
      }
    });

  themeBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    themeDropdown?.classList.toggle("hidden");
  });

  document.addEventListener("click", () => {
    themeDropdown?.classList.add("hidden");
  });

  themeOptions.forEach((opt) => {
    opt.addEventListener("click", () => {
      const selectedTheme = opt.getAttribute("data-theme");
      if (selectedTheme) applyTheme(selectedTheme);
    });
  });

  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");
  const navLinks = document.querySelectorAll(".mobile-nav-link");

  function toggleMenu() {
    const isHidden = mobileMenu?.classList.contains("hidden");
    if (isHidden) {
      mobileMenu?.classList.remove("hidden");
      mobileMenu?.classList.add("flex");
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
    } else {
      mobileMenu?.classList.add("hidden");
      mobileMenu?.classList.remove("flex");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    }
  }

  toggleBtn?.addEventListener("click", toggleMenu);
  navLinks.forEach((link) =>
    link.addEventListener(
      "click",
      () => !mobileMenu?.classList.contains("hidden") && toggleMenu()
    )
  );
</script>
